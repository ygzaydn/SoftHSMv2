# Copied to /opt/softhsm2/etc/gsm.env (root:softhsm, mode 640).
#
# SECURITY WARNING: softhsm-gsm speaks plain, unauthenticated TCP
# (see doc/MILENAGE-5G-AKA-DESIGN.md). LISTEN_ADDR defaults to loopback
# on purpose. Only change it to a non-loopback address if the network
# between here and the UDM host is one you already trust as much as
# this host's own process memory -- there is no TLS in this build.

TOKEN_LABEL=open5gs-milenage
LISTEN_ADDR=127.0.0.1
LISTEN_PORT=9999
# Same-host Open5GS UDM: set this to /run/softhsm-gsm/gsm.sock.
# The daemon listens on this Unix socket and TCP at the same time.
# The Open5GS service user must be in the softhsm group to connect.
LISTEN_UNIX=/run/softhsm-gsm/gsm.sock

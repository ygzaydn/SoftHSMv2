# Copied to /opt/softhsm2-milenaged/config/milenaged.env (root:softhsm, mode 640).
#
# SECURITY WARNING: softhsm2-milenaged speaks plain, unauthenticated TCP
# (see doc/MILENAGE-5G-AKA-DESIGN.md). LISTEN_ADDR defaults to loopback
# on purpose. Only change it to a non-loopback address if the network
# between here and the UDM host is one you already trust as much as
# this host's own process memory -- there is no TLS in this build.

TOKEN_LABEL=open5gs-milenage
LISTEN_ADDR=127.0.0.1
LISTEN_PORT=9999
